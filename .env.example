# Supabase public client credentials (safe to embed in mobile app; RLS enforces security)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# Used ONLY by local CLI scripts (e.g. scripts/import-ledger.ts) — NEVER prefix with EXPO_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
