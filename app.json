{
  "expo": {
    "name": "Anjuman Khata",
    "slug": "Anjuman_Khata",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "anjumankhata",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anjumankhata.app",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.anjumankhata.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C503C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C503C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#072E22",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      "expo-asset",
      "./plugins/withNativePdfDownloader",
      "./plugins/withApkCompression"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1920d8ee-6c22-4eef-87bf-dd5bdb8cb005"
      }
    },
    "owner": "sardar_hussain"
  }
}
